{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -f \"$root/scripts/agent/hooks/session-start.sh\" ] || root=\"$CLAUDE_PROJECT_DIR\"; [ ! -f \"$root/scripts/agent/hooks/session-start.sh\" ] || exec bash \"$root/scripts/agent/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -f \"$root/scripts/agent/hooks/dist-guard.js\" ] || root=\"$CLAUDE_PROJECT_DIR\"; [ ! -f \"$root/scripts/agent/hooks/dist-guard.js\" ] || exec node \"$root/scripts/agent/hooks/dist-guard.js\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash scripts/agent/verify.sh*)",
      "Bash(bash scripts/agent/smoke.sh*)",
      "Bash(bash scripts/agent/golden.sh)",
      "Bash(bash scripts/agent/card-preview.sh*)",
      "Bash(bash scripts/agent/action-contract.sh)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run format:check)",
      "Bash(pnpm run ci-test)"
    ],
    "deny": [
      "Read(./.env*)",
      "Edit(./.env*)",
      "Bash(cat .env*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(yarn *)"
    ]
  },
  "extraKnownMarketplaces": {
    "megalinter": {
      "source": {
        "source": "github",
        "repo": "oxsecurity/megalinter"
      }
    },
    "egm": {
      "source": {
        "source": "github",
        "repo": "google/elephant-goldfish-model"
      }
    }
  },
  "enabledPlugins": {
    "megalinter@megalinter": true,
    "egm@egm": true
  }
}
